{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI API Monitor",
  "version": "0.1.0",
  "identifier": "com.aiapimonitor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI API Monitor",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
